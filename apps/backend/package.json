{
  "name": "liceu-academy-api",
  "version": "7.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "contracts:generate": "tsx scripts/generate-contracts.ts",
    "contracts:check": "npm run contracts:generate && git diff --exit-code -- contracts/backend.contracts.json ../../docs/contracts/backend.contracts.json",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/websocket": "^11.0.0",
    "@prisma/client": "^5.0.0",
    "bcrypt": "^5.1.0",
    "fastify": "^5.0.0",
    "ioredis": "^5.3.0",
    "nats": "^2.29.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.7.4",
    "prisma": "^5.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "zod-to-json-schema": "^3.23.5"
  }
}
