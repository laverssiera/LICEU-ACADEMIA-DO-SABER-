{
  "name": "liceu-academia-do-saber",
  "version": "1.0.0",
  "description": "API inicial da LICEU Engenharia - Academia do Saber",
  "main": "src/server.js",
  "type": "commonjs",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "python:setup": "bash scripts/setup-python-venvs.sh",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "node --test",
    "dev:workspace": "turbo run dev --parallel",
    "test:workspace": "turbo run test",
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f"
  },
  "keywords": [
    "educacao",
    "api",
    "liceu",
    "gamificacao"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "ioredis": "^5.4.1",
    "nats": "^2.28.2",
    "neo4j-driver": "^5.28.1",
    "prom-client": "^15.1.3",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "eslint": "^9.16.0",
    "supertest": "^7.2.2",
    "turbo": "^2.5.0"
  },
  "packageManager": "npm@10.8.2"
}
